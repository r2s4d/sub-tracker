# Скопируйте в .env на сервере, заполните и закройте права: chmod 600 .env
# Файл .env не коммитится.

# Логин администратора Grafana (не admin: это первое, что перебирают боты)
GRAFANA_ADMIN_USER=change-me
# Длинный случайный пароль, например: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=change-me

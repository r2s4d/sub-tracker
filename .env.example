# Скопируйте в .env и заполните значения. Файл .env не коммитится.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=subtracker
POSTGRES_USER=subtracker
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Адрес сайта - для ссылок в письмах
SITE_URL=http://localhost:8000

# Почта через SMTP Яндекса. Пока EMAIL_BACKEND не задан, письма не отправляются,
# а печатаются в консоль (удобно для разработки).
# Для отправки: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend,
# EMAIL_HOST_USER - ваш адрес на Яндексе, EMAIL_HOST_PASSWORD - не пароль от почты,
# а пароль приложения: Яндекс ID → Безопасность → Пароли приложений (тип «Почта»).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Отправитель; если пусто - EMAIL_HOST_USER (Яндекс требует, чтобы они совпадали)
DEFAULT_FROM_EMAIL=
